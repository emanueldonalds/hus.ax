package web 

import "github.com/emanueldonalds/husax/db"

templ Index(listings []db.Listing, lastScrape db.ScrapeEvent, orderBy string, sortOrder string) {
	@Layout(templ.NopComponent, filters(), Listings(listings, lastScrape, orderBy, sortOrder))
	<script src="/assets/index.js"></script>
}

type sortOption struct {
	Value string
	Label string
}

var sortOptions = []sortOption{
	{"", "Senast upptäckt"},
	{"first_seen:asc", "Upptäckt (äldst först)"},
	{"price:asc", "Pris (lägst först)"},
	{"price:desc", "Pris (högst först)"},
	{"price_over_area:asc", "Pris/m2 (lägst först)"},
	{"price_over_area:desc", "Pris/m2 (högst först)"},
	{"size_value:desc", "Area (störst först)"},
	{"size_value:asc", "Area (minst först)"},
	{"rooms:desc", "Rum (flest först)"},
	{"rooms:asc", "Rum (färrest först)"},
	{"build_year:desc", "Årtal (nyast först)"},
	{"build_year:asc", "Årtal (äldst först)"},
	{"address:asc", "Adress (A-Ö)"},
	{"address:desc", "Adress (Ö-A)"},
	{"agency:asc", "Mäklare (A-Ö)"},
	{"agency:desc", "Mäklare (Ö-A)"},
}

templ filters() {
	<button type="button" id="filters-toggle" aria-controls="filters" aria-expanded="false">
		Filter <span id="filters-count"></span>
	</button>
	<form id="filters" hx-get="/filter" hx-target="#listings" hx-trigger="change, submit">
		<div class="input-group">
			<label>Sök</label>
			<input class="input-field" placeholder="Fritext" id="search" name="search"/>
		</div>
		@inputSort()
		@inputRange("price_min", "price_max", "Pris")
		@inputRange("build_year_min", "build_year_max", "År")
		@inputRange("size_value_min", "size_value_max", "Area")
		@inputRange("price_over_area_min", "price_over_area_max", "Pris/m2")
		@inputAgency()
		@inputIncludeDeleted()
		<input type="hidden" id="order_by" name="order_by"/>
		<input type="hidden" id="sort_order" name="sort_order"/>
		<button id="send" type="submit">Filtrera</button>
	</form>
}

templ inputSort() {
	<div class="input-group sort-group">
		<label for="sort-select">Sortera</label>
		<select id="sort-select">
			for _, o := range sortOptions {
				<option value={ o.Value }>{ o.Label }</option>
			}
		</select>
	</div>
}

templ inputRange(minId string, maxId string, title string) {
	<div class="input-group">
		<label>{ title }</label>
		<div class="input-range-fields">
			<input class="input-field" placeholder="min" id={ minId } name={ minId } type="number"/>
			<input class="input-field" placeholder="max" id={ maxId } name={ maxId } type="number"/>
		</div>
	</div>
}

templ inputAgency() {
	<div class="input-group">
		<label for="agency">Mäklare</label>
		<select id="agency" name="agency">
			<option value="">Alla</option>
			<option>Mäklarhuset</option>
			<option>Lyyski</option>
			<option>Fastighetskonsult</option>
			<option>Aktia LKV</option>
			<option>Din Fastighet</option>
		</select>
	</div>
}

templ inputIncludeDeleted() {
	<div class="input-group">
		<label for="include_deleted">Visa borttagna</label>
		<input type="checkbox" id="include_deleted" name="include_deleted" value="true"/>
	</div>
}
